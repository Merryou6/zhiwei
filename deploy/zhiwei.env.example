# ============================================================
# 知微 · 部署环境变量（复制为 zhiwei.env 后填写：cp zhiwei.env.example zhiwei.env）
# 此文件只是模板，真实 zhiwei.env 已被 .gitignore 排除，不会进仓库
# ============================================================

# ---------- 必改（安全红线）----------
# token 签名密钥：拿到它 = 可伪造任意登录态。生成一条够用的随机串：
#   openssl rand -hex 32
ZHIWEI_SERVER_SECRET=CHANGE_ME_请用_openssl_rand_hex_32_生成

# ---------- 可选（一般保持默认）----------
# 宿主机映射端口（改这里等于改 docker-compose.yml 的 ports 左值）
# ZHIWEI_HOST_PORT=8080

# 存储后端：json（默认，本地 JSON 文件）。
# 注意：cloudbase 适配器目前是桩（未接 SDK），不要改成 cloudbase。
# ZHIWEI_DB=json

# 模型模式：
#   local  （默认）确定性规则适配器——诊断/对话/试卷识别为规则模拟，零外部依赖
#   remote 接真实大模型（OpenAI 兼容协议，如 DeepSeek），需同时填下面 ZHIWEI_LLM_* 三项
# ZHIWEI_MODEL_MODE=local

# ---------- 可选（仅 ZHIWEI_MODEL_MODE=remote 时需要）----------
# OpenAI 兼容接口地址（含 /v1，DeepSeek 官方示例）与模型名
# ZHIWEI_LLM_BASE_URL=https://api.deepseek.com/v1
# ZHIWEI_LLM_MODEL=deepseek-chat
# API Key（机密！只写在本文件，已被 .gitignore 排除）
# ZHIWEI_LLM_API_KEY=sk-xxxx
# 远程调用超时毫秒数（默认 45000；超时或任何失败自动回落本地规则适配器）
# ZHIWEI_LLM_TIMEOUT_MS=45000
