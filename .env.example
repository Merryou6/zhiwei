# 模型模式（与 deploy/zhiwei.env.example 同义）：
#   local （默认）确定性规则适配器——诊断 / 对话 / 试卷识别为规则模拟，零外部依赖，不填即此值
#   remote 接真实大模型（OpenAI 兼容协议），需同时填下面 ZHIWEI_LLM_* 三项
# ZHIWEI_MODEL_MODE=local

# 对话辅导接入 DeepSeek / 任意 OpenAI 兼容大模型（仅进程环境变量，.env 本身已被 .gitignore 忽略，不会入库）
ZHIWEI_LLM_BASE_URL=https://api.deepseek.com/v1
ZHIWEI_LLM_API_KEY=your-deepseek-key-here
ZHIWEI_LLM_MODEL=deepseek-chat
# 可选：调用超时（毫秒）
ZHIWEI_LLM_TIMEOUT_MS=45000
